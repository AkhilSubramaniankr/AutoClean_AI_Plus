# Copy this file to `.env` and fill in real values. Never commit the real `.env` file.
# All variables are prefixed AUTOCLEAN_ to match Settings.model_config.env_prefix
# in src/autoclean/config/settings.py.

AUTOCLEAN_ENVIRONMENT=development
AUTOCLEAN_LOG_LEVEL=INFO

# --- LLM client (Decision & Reporting Agent only) ---
# Requires a running Ollama server. Install from https://ollama.com, then:
#   ollama pull llama3.1:8b
AUTOCLEAN_LLM_PROVIDER=ollama
AUTOCLEAN_LLM_MODEL=llama3.2:latest
AUTOCLEAN_LLM_BASE_URL=http://localhost:11434
# AUTOCLEAN_LLM_API_KEY is not needed for Ollama; leave unset.
AUTOCLEAN_LLM_MAX_TOKENS=1024
AUTOCLEAN_LLM_TEMPERATURE=0.2
AUTOCLEAN_LLM_TIMEOUT_SECONDS=60

# --- Paths (relative to project root unless absolute) ---
AUTOCLEAN_DATA_UPLOAD_DIR=data/uploads
AUTOCLEAN_DATA_CLEANED_DIR=data/cleaned
AUTOCLEAN_REPORTS_DIR=data/reports
AUTOCLEAN_SCRIPTS_DIR=data/scripts
AUTOCLEAN_DATABASE_PATH=data/autoclean.db

# --- Evaluation engine ---
AUTOCLEAN_EM_MAX_ITERATIONS=50
AUTOCLEAN_EM_CONVERGENCE_TOLERANCE=0.0001

# --- Streamlit / interactive limits ---
AUTOCLEAN_MAX_UPLOAD_SIZE_MB=200
AUTOCLEAN_MAX_PREVIEW_ROWS=1000
